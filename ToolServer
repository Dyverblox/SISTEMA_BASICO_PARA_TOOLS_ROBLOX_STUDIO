-- EVENTOS DE ENTORNO FÍSICO
--------------------------------------------------------------------------------------------------------
Tool.Equipped:Connect(function()
	changeToolCollisions(false) 
	local oldStabilizer = Handle:FindFirstChild("DropStabilizer")
	if oldStabilizer then oldStabilizer:Destroy() end
	Handle.AssemblyLinearVelocity = Vector3.zero
	Handle.AssemblyAngularVelocity = Vector3.zero
	clearAllEffects()
	runFolderEffects("Equipar")
end)

Tool.Unequipped:Connect(function()
	stopFolderEffects("Equipar")
	clearAllEffects() 
	if conexionContacto then conexionContacto:Disconnect() conexionContacto = nil end

	task.defer(function()
		if Tool:IsDescendantOf(workspace) then
			Handle.CFrame = CFrame.new(Handle.Position) * initialRotation
			local alignOrientation = Instance.new("AlignOrientation")
			alignOrientation.Name = "DropStabilizer"
			alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment 
			alignOrientation.Attachment0 = dropAttachment 
			alignOrientation.CFrame = initialRotation 
			alignOrientation.MaxTorque = 100000       
			alignOrientation.Responsiveness = 200     
			alignOrientation.Parent = Handle
			changeToolCollisions(true) 
			runFolderEffects("Soltar") 
			local conexionColision
			conexionColision = Handle.Touched:Connect(function(hit)
				if hit and not hit:IsDescendantOf(Players) and not hit.Parent:FindFirstChildOfClass("Humanoid") then
					if alignOrientation then alignOrientation:Destroy() end
					if conexionColision then conexionColision:Disconnect() end 
				end
			end)
			task.delay(5, function()
				if alignOrientation and alignOrientation.Parent then alignOrientation:Destroy() end
				if conexionColision then conexionColision:Disconnect() end
			end)
		else
			changeToolCollisions(false)
			runFolderEffects("Desequipar")
		end
	end)
end)

clearAllEffects()
if Tool:IsDescendantOf(workspace) and not Tool.Parent:FindFirstChildOfClass("Humanoid") then
	changeToolCollisions(true) 
	task.defer(function()
		if Tool and Tool.Parent then
			runFolderEffects("Soltar", true)
			if Handle:IsA("BasePart") then Handle.AssemblyLinearVelocity = Vector3.new(0, 0.01, 0) end
		end
	end)
else
	changeToolCollisions(false)
end
